# FLOTER configuration template (safe to commit: placeholders only).
#
# Copy this file to .env and fill in your values. Only one file is read:
#   source runs      -> .env in this folder
#   installed EXE    -> %USERPROFILE%\.floter\.env
#   either (override) -> the path in the FLOTER_ENV_FILE environment variable
# Never put real keys in this template or in the installer.
# Restart FLOTER after editing.

# --- Jev (required): routes every command -----------------------------------
# TypeSafe API key for Jev.
Jev_API_Key=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# Blank uses jev-latest.
JEV_MODEL=

# --- Gemini (optional): screen analysis, app navigation and questions --------
# With only these two set, Gemini also handles app navigation ("open Claude and
# click Cowork") and questions via its OpenAI-compatible endpoint.
# Run: python scripts/check_gemini.py  to list your models and test the key.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: a vision-capable model for "what's on my screen" (uses the native Gemini API with images)
GEMINI_VISION_MODEL=
# Optional: comma-separated backups, tried in order when a Gemini call is busy or fails.
GEMINI_FALLBACK_MODELS=


# --- Separate reasoning provider (optional; overrides Gemini) ----------------
# OPENROUTER_API_KEY=
# HERMES_API_KEY=
# HERMES_API_BASE=https://openrouter.ai/api/v1
# HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b
# Navigation-only override (OpenAI-compatible chat completions):
# GUI_MODEL_API_BASE=
# GUI_MODEL=
# GUI_MODEL_API_KEY=

# --- OmniParser (optional local visual fallback for app navigation) ----------
# FLOTER starts the service automatically when needed. For the built EXE, point
# OMNIPARSER_HOME at the source folder that contains .tools\omniparser-env.
OMNIPARSER_HOME=
OMNIPARSER_DEVICE=cuda
# OMNIPARSER_URL=http://127.0.0.1:8766

# --- Speech ------------------------------------------------------------------
WAKE_WORD=hey rex
STT_ENGINE=auto
WHISPER_MODEL_PATH=
WHISPER_DEVICE=auto
SPEECH_SILENCE_SECONDS=0.7
SPEECH_PARTIAL_SECONDS=0.6
VOICE_FOLLOWUP_SECONDS=20
# Lightweight offline option: STT_ENGINE=vosk and an extracted Vosk model directory.
VOSK_MODEL_PATH=

# --- Snippy MCP (optional screenshots/OCR) -----------------------------------
# Local SSE URL; when set it takes precedence over SNIPPY_COMMAND.
SNIPPY_URL=
# Absolute path to the Snippy executable.
SNIPPY_COMMAND=
SNIPPY_ARGS=["--mcp-stdio"]
SNIPPY_CWD=

# --- Camera ------------------------------------------------------------------
# Blank device selects the Windows default; otherwise the exact device description.
CAMERA_DEVICE=
# Blank saves to %USERPROFILE%\Pictures\FLOTER.
CAMERA_SAVE_DIR=
# Automatic recording limit, 1-300 seconds; say "stop recording" to finish early.
CAMERA_VIDEO_SECONDS=60
CAMERA_RECORD_AUDIO=1

# --- Apps --------------------------------------------------------------------
# Installed apps (Claude, Codex, Gemini, Antigravity...) are registered in
# %USERPROFILE%\.floter\applications.json; see CONFIGURATION.md.
MICA_ENABLED=1

# --- Browser automation (experimental) ----------------------------------------
# 1 opens websites in FLOTER's own browser window and lets Rex act inside the page
# (search a site, click a result). Every action is reviewed. Needs: pip install ".[browser]"
BROWSER_AUTOMATION=0
# Installed browser to drive: msedge, chrome or brave (no extra browser download).
# FLOTER always uses its own profile, even with brave.
BROWSER_CHANNEL=msedge
# Blank uses %USERPROFILE%\.floter\browser-profile (separate from your everyday browser).
BROWSER_PROFILE_DIR=
# Sites where Rex may click or type, comma-separated; subdomains included.
BROWSER_INPUT_SITES=youtube.com,google.com,wikipedia.org
